{
    "name": "request-app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "npm run test:legacy && npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "test:legacy": "node src/utils/adapters.test.js && node src/utils/cache.test.js && node src/utils/quota.test.js && node src/utils/holidays.test.js && node src/utils/leaveTracking.test.js",
        "test:phase1": "node scripts/build-appscript.mjs --check && node --test tests/phase1/*.test.mjs",
        "build:appscript": "node scripts/build-appscript.mjs",
        "test:phase2": "node --test tests/phase2/*.test.mjs",
        "test:phase3": "node --test tests/phase3/*.test.mjs",
        "test:phase4": "node --test tests/phase4/*.test.mjs",
        "test:phase5": "node --test tests/phase5/*.test.mjs",
        "test:phase6": "node --test tests/phase6/*.test.mjs"
    },
    "dependencies": {
        "docxtemplater": "^3.69.0",
        "file-saver": "^2.0.5",
        "lucide-react": "^1.17.0",
        "pizzip": "^3.2.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.1.0",
        "autoprefixer": "^10.4.16",
        "gh-pages": "^6.3.0",
        "postcss": "^8.4.31",
        "puppeteer-core": "^25.0.4",
        "tailwindcss": "^3.4.1",
        "vite": "^7.1.7"
    }
}
